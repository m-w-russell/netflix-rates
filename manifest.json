{
  "name": "Show Ratings on Netflix",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Shows IMDb ratings from OMDB on the Netflix details popup.",
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/injectRating.js"
      ]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8788/*"
  ],
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }

}
